# Auth0 Regular Web Application
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Separate Auth0 Machine-to-Machine application, Management API scopes:
# create:users, delete:users
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
AUTH0_CONNECTION=Username-Password-Authentication

# Supabase project with Auth0 Third-Party Auth integration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Independent random 32+ byte secret for synchronizer CSRF tokens
CSRF_SECRET=

# Local preview only. Ignored unless NODE_ENV=development.
DEMO_MODE=false
